# =====================================================
# Cloudinary Configuration
# Sao chép file này thành .env và điền giá trị thực
# cp .env.example .env
# =====================================================

# [BẮT BUỘC] Tên cloud Cloudinary của bạn
# Tìm tại: https://console.cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# [BẮT BUỘC] API Key từ Cloudinary Console
CLOUDINARY_API_KEY=your_api_key_here

# [BẮT BUỘC] API Secret từ Cloudinary Console
CLOUDINARY_API_SECRET=your_api_secret_here

# =====================================================
# Optional / Debug
# =====================================================

# [TÙY CHỌN] Chỉ dùng khi debug/test thủ công
# Đặt giá trị là relative path từ domain nguồn, ví dụ:
# TEST_LINK=/ten-tran-dau-id
# TEST_LINK=
